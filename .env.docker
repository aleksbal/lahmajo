# Docker environment file for Lahmajo
# Copy this to .env and adjust values as needed

# Elasticsearch Configuration
VECTOR_INDEX_PROVIDER=elasticsearch
BM25_PROVIDER=elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX=lahmajo_vectors
ELASTICSEARCH_USE_NATIVE_HYBRID=true

# LLM Provider Configuration
# Options: ollama_local, ollama_cloud, openai
LLM_PROVIDER=ollama_local
EMBEDDING_PROVIDER=ollama_local

# Ollama Configuration (for local/ollama_local)
LLM_BASE_URL=http://host.docker.internal:11434
EMBEDDING_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=gpt-oss:120b-cloud
EMBEDDING_MODEL=embeddinggemma
LLM_TEMPERATURE=0.1

# OpenAI Configuration (uncomment and set if using openai)
# LLM_PROVIDER=openai
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=your-openai-api-key-here
# LLM_MODEL=gpt-4
# EMBEDDING_MODEL=text-embedding-ada-002

# Ollama Cloud Configuration (uncomment and set if using ollama_cloud)
# LLM_PROVIDER=ollama_cloud
# EMBEDDING_PROVIDER=ollama_cloud
# LLM_BASE_URL=https://your-ollama-cloud-url.com
# EMBEDDING_BASE_URL=https://your-ollama-cloud-url.com
# LLM_MODEL=gpt-oss:120b-cloud
# EMBEDDING_MODEL=embeddinggemma